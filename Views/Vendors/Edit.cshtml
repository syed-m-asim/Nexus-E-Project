@* Edit-vendor form (Admin). *@
@model NexusCommunication.Models.Vendor
@{ ViewData["Title"] = "Edit Vendor"; }
<h2>Edit Vendor</h2>
<form asp-action="Edit" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Cisco Systems" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="ContactPerson"></label><input asp-for="ContactPerson" placeholder="e.g. Sara Ahmed" class="form-control" required /><span asp-validation-for="ContactPerson" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" placeholder="e.g. 03001234567" class="form-control" required /><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Email"></label><input asp-for="Email" placeholder="e.g. name@example.com" class="form-control" required /><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Address"></label><input asp-for="Address" placeholder="House / street / area, city" class="form-control" required /><span asp-validation-for="Address" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
