@* Add-store form (Admin). City is mandatory. *@
@model NexusCommunication.Models.RetailStore
@{ ViewData["Title"] = "Add Retail Store"; }
<h2>Add Retail Store</h2>
<form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Nexus Store - Clifton" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label>City</label><select asp-for="CityId" class="form-select" required asp-items="ViewBag.CityId"><option value="">-- Select city --</option></select><span asp-validation-for="CityId" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Address"></label><input asp-for="Address" placeholder="House / street / area, city" class="form-control" required /><span asp-validation-for="Address" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" placeholder="e.g. 03001234567" class="form-control" required /><span asp-validation-for="Phone" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
