@* Purchase order details with the Receive (update stock) button and the vendor payment form. *@
@model NexusCommunication.Models.PurchaseOrder
@{ ViewData["Title"] = "PO Details"; }
<h2>Purchase Order @Model.PoNumber</h2>
<dl class="row">
<dt class="col-sm-3">Vendor</dt><dd class="col-sm-9">@Model.Vendor?.Name</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
<dt class="col-sm-3">Total / Paid</dt><dd class="col-sm-9">@Model.TotalAmount.ToString("C") / @Model.AmountPaid.ToString("C")</dd>
<dt class="col-sm-3">Order Date</dt><dd class="col-sm-9">@Model.OrderDate</dd>
@if (Model.ReceivedOn.HasValue) { <dt class="col-sm-3">Received</dt><dd class="col-sm-9">@Model.ReceivedOn</dd> }
</dl>
<h4>Items</h4>
<table class="table table-sm"><thead><tr><th>Product</th><th>Qty</th><th>Unit Cost</th></tr></thead>
<tbody>@foreach (var i in Model.Items) { <tr><td>@i.Product?.Name</td><td>@i.Quantity</td><td>@i.UnitCost.ToString("C")</td></tr> }</tbody></table>
@if (Model.Status != NexusCommunication.Models.PurchaseOrderStatus.Received)
{
<form asp-action="Receive" method="post" class="mb-3"><input type="hidden" name="id" value="@Model.Id" />
<button type="submit" class="btn btn-success">Mark Received (update stock)</button></form>
}
<h4>Vendor Payments</h4>
@if (Model.Payments?.Any() == true) {
<table class="table table-sm"><thead><tr><th>Amount</th><th>Mode</th><th>Date</th><th>Ref</th></tr></thead>
<tbody>@foreach (var pay in Model.Payments) { <tr><td>@pay.Amount.ToString("C")</td><td>@pay.Mode</td><td>@pay.PaidOn.ToString("dd MMM yyyy")</td><td>@pay.Reference</td></tr> }</tbody></table>
}
<form asp-action="AddPayment" method="post" class="row g-2 mb-3">
<input type="hidden" name="id" value="@Model.Id" />
<div class="col-auto"><input name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Amount" required /></div>
<div class="col-auto"><select name="mode" class="form-select" asp-items="Html.GetEnumSelectList<NexusCommunication.Models.PaymentMode>()"></select></div>
<div class="col-auto"><input name="reference" class="form-control" placeholder="Reference" maxlength="100" /></div>
<div class="col-auto"><button type="submit" class="btn btn-primary">Add Payment</button></div>
</form>
<a asp-action="Index" class="btn btn-secondary">Back</a>
