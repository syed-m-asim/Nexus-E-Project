@* List page: all purchase orders in a table with action links. *@
@model IEnumerable<NexusCommunication.Models.PurchaseOrder>
@{ ViewData["Title"] = "Purchase Orders"; }
<h2>Purchase Orders <a class="btn btn-sm btn-success" asp-action="Create">New PO</a></h2>
<table class="table table-striped">
<thead><tr><th>PO #</th><th>Vendor</th><th>Date</th><th>Total</th><th>Paid</th><th>Status</th><th class="th-actions">Actions</th></tr></thead>
<tbody>
@foreach (var p in Model) {
<tr>
<td>@p.PoNumber</td><td>@p.Vendor?.Name</td><td>@p.OrderDate.ToString("dd MMM yyyy")</td>
<td>@p.TotalAmount.ToString("C")</td><td>@p.AmountPaid.ToString("C")</td><td>@p.Status</td>
<td><a asp-action="Details" asp-route-id="@p.Id">Details</a> | <a asp-action="Delete" asp-route-id="@p.Id" class="text-danger">Delete</a></td>
</tr>
}
</tbody>
</table>
