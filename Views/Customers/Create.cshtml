@* Add-customer form. Name, phone and e-mail rules come from the Customer model; unique e-mail is checked in CustomersController. *@
@model NexusCommunication.Models.Customer
@{ ViewData["Title"] = "Add Customer"; }
<h2>Add Customer</h2>
<form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Ahmed Khan" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" placeholder="e.g. 03001234567" class="form-control" required /><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Email"></label><input asp-for="Email" placeholder="e.g. name@example.com" class="form-control" required /><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Address"></label><input asp-for="Address" placeholder="House / street / area, city" class="form-control" required /><span asp-validation-for="Address" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
