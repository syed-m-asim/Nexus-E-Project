@* List page: all employees in a table with action links. *@
@model IEnumerable<NexusCommunication.Models.Employee>
@{ ViewData["Title"] = "Employees"; }
<h2>Employees <a class="btn btn-sm btn-success" asp-action="Create">Add</a></h2>
<table class="table table-striped"><thead><tr><th>Name</th><th>Role</th><th>Phone</th><th>Store</th><th>Active</th><th class="th-actions">Actions</th></tr></thead>
<tbody>@foreach (var e in Model) {
<tr><td>@e.Name</td><td>@e.Role</td><td>@e.Phone</td><td>@e.RetailStore?.Name</td><td>@e.IsActive</td>
<td><a asp-action="Details" asp-route-id="@e.Id">Details</a> | <a asp-action="Edit" asp-route-id="@e.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@e.Id" class="text-danger">Delete</a></td></tr>
}</tbody></table>
