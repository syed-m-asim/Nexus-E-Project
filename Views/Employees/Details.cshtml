@* Details page: read-only view of one employee. *@
@model NexusCommunication.Models.Employee
@{ ViewData["Title"] = "Employee"; }
<h2>@Model.Name</h2>
<dl class="row">
<dt class="col-sm-3">Role</dt><dd class="col-sm-9">@Model.Role</dd>
<dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Store</dt><dd class="col-sm-9">@Model.RetailStore?.Name</dd>
<dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
