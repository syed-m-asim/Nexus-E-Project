@* Delete confirmation page for a plan. The record is deleted only after the user confirms (POST + anti-forgery token). *@
@model NexusCommunication.Models.Plan
@{ ViewData["Title"] = "Delete Plan"; }
<h2>Delete Plan?</h2>
<p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
<form asp-action="Delete" method="post">
<input type="hidden" asp-for="Id" />
<button type="submit" class="btn btn-danger">Delete</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
