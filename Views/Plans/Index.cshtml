@model IEnumerable<NexusCommunication.Models.Plan>
@{ ViewData["Title"] = "Plans";
   bool isAdmin = User.IsInRole("Admin"); }
<h2>Plans
@if (isAdmin) { <a class="btn btn-sm btn-success" asp-action="Create">Add Plan</a> }
</h2>
<table class="table table-striped">
<thead><tr><th>Name</th><th>Type</th><th>Group</th><th>Price</th><th>Validity (days)</th><th>Active</th><th class="th-actions">Actions</th></tr></thead>
<tbody>
@foreach (var p in Model) {
<tr>
<td>@p.Name</td><td>@p.ConnectionType</td><td>@p.PlanGroup</td><td>@p.Price.ToString("C")</td><td>@p.ValidityDays</td>
<td>@(p.IsActive ? "Yes" : "No")</td>
<td>
<a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Details</a>
@if (isAdmin) {
 <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
 <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
}
</td>
</tr>
}
</tbody>
</table>
