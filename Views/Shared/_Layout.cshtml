@* Master layout: glass navigation (menus depend on the logged-in user's role), animated particle background, theme switch,
   alert area for TempData Success/Error messages and the page body. Styling lives in wwwroot/css/site.css, behaviour in wwwroot/js/site.js. *@
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Communication</title>
    <script>
        // Set theme before the page is painted (no flash) and tell CSS that JavaScript is available.
        (function () { try { var t = localStorage.getItem('nx-theme'); if (t) document.documentElement.setAttribute('data-bs-theme', t); } catch (e) { } document.documentElement.classList.add('js'); })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="nx-progress"></div>
    <canvas id="bg-canvas"></canvas>
    <div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div>
    <header class="nx-header">
        <nav class="navbar navbar-expand-xl navbar-dark nx-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-cube"><i></i><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="brand-text">Nexus Communication</span>
                </a>
                <div class="nav-mobile-tools">
                    <button type="button" class="theme-toggle" title="Switch light / dark theme" aria-label="Switch light / dark theme"><i class="bi bi-sun-fill"></i></button>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Search" asp-action="Index"><i class="bi bi-search"></i> Search Status</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-shield-lock"></i> Admin</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Plans" asp-action="Index">Plans</a></li>
                                    <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">Employees</a></li>
                                    <li><a class="dropdown-item" asp-controller="RetailStores" asp-action="Index">Retail Stores</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vendors" asp-action="Index">Vendors</a></li>
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Products / Stock</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cities" asp-action="Index">Cities</a></li>
                                    <li><a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Index">Purchase Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Documents" asp-action="Index">Documents</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Reports</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("RetailEmployee") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-shop"></i> Retail</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index">Customers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Create">Place Order</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">Payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Feedbacks" asp-action="Index">Feedbacks</a></li>
                                    <li><a class="dropdown-item" asp-controller="Documents" asp-action="Index">Documents</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Technical") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-tools"></i> Technical</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Pending">Pending Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Connections" asp-action="Index">Connections</a></li>
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Equipment</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Accounts") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-receipt"></i> Accounts</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Bills" asp-action="Index">Bills</a></li>
                                    <li><a class="dropdown-item" asp-controller="Bills" asp-action="Generate">Generate Bill</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">Payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Reports</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> My Portal</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="Index">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="PlaceOrder">Place Order</a></li>
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="Orders">My Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="Connections">My Connections</a></li>
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="Bills">My Bills</a></li>
                                    <li><a class="dropdown-item" asp-controller="MyPortal" asp-action="Profile">My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Plans" asp-action="Index">Browse Plans</a></li>
                                    <li><a class="dropdown-item" asp-controller="Feedbacks" asp-action="Create">Give Feedback</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <button type="button" class="theme-toggle theme-toggle-desktop me-xl-3" title="Switch light / dark theme" aria-label="Switch light / dark theme"><i class="bi bi-sun-fill"></i></button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container nx-content">
        <main role="main" class="pb-4">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </main>
    </div>
    <footer class="footer mt-4 py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span><span class="brand-text fw-bold">Nexus Communication</span> &copy; 2026 - Telecom &amp; Internet Services</span>
            <span><i class="bi bi-telephone"></i> Dial-Up &nbsp; <i class="bi bi-wifi"></i> Broadband &nbsp; <i class="bi bi-telephone-inbound"></i> Landline</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
