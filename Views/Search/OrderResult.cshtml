@* Result page of an order search (status of the order). *@
@model NexusCommunication.Models.Order
@{ ViewData["Title"] = "Order Status"; }
<h2>Order Status</h2>
<dl class="row">
    <dt class="col-sm-3">Order ID</dt><dd class="col-sm-9"><strong>@Model.OrderNumber</strong></dd>
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.Name</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Customer?.Phone</dd>
    <dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@Model.Plan?.Name</dd>
    <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.ConnectionType</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge bg-info">@Model.Status</span></dd>
    <dt class="col-sm-3">Placed On</dt><dd class="col-sm-9">@Model.PlacedOn.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Retail Store</dt><dd class="col-sm-9">@Model.RetailStore?.Name</dd>
    <dt class="col-sm-3">Bulk Discount</dt><dd class="col-sm-9">@Model.BulkDiscountPercent%</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Back to Search</a>
