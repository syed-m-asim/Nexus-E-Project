@* Result page of an account search (connection status and bills / due amount). *@
@model NexusCommunication.Models.Connection
@{ ViewData["Title"] = "Connection Status"; }
<h2>Connection Status</h2>
<dl class="row">
    <dt class="col-sm-3">Account ID</dt><dd class="col-sm-9"><strong>@Model.AccountId</strong></dd>
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.Name</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Customer?.Phone</dd>
    <dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@Model.Plan?.Name</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge bg-success">@Model.Status</span></dd>
    <dt class="col-sm-3">Activated</dt><dd class="col-sm-9">@Model.ActivatedOn.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Security Deposit</dt><dd class="col-sm-9">@Model.SecurityDepositCharged.ToString("C")</dd>
</dl>
@if (Model.Bills?.Any() == true)
{
    <h4>Bills</h4>
    <table class="table table-sm">
        <thead><tr><th>Bill #</th><th>Date</th><th>Total</th><th>Due</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Bills)
        {
            <tr>
                <td>@b.BillNumber</td>
                <td>@b.BillDate.ToString("dd MMM yyyy")</td>
                <td>@b.TotalAmount.ToString("C")</td>
                <td>@b.BalanceDue.ToString("C")</td>
                <td>@b.Status</td>
            </tr>
        }
        </tbody>
    </table>
}
<a asp-action="Index" class="btn btn-secondary">Back to Search</a>
