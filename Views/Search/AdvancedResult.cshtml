@* Result page of the advanced search (matching orders and connections, maximum 50 each). *@
@{ ViewData["Title"] = "Advanced Search Results"; }
<h2>Advanced Search Results</h2>
@{
    var orders = ViewBag.Orders as IEnumerable<NexusCommunication.Models.Order>;
    var connections = ViewBag.Connections as IEnumerable<NexusCommunication.Models.Connection>;
}
<h4>Orders</h4>
<table class="table table-striped table-sm">
    <thead><tr><th>Order ID</th><th>Customer</th><th>Type</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
    @if (orders != null) { foreach (var o in orders) {
        <tr>
            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">@o.OrderNumber</a></td>
            <td>@o.Customer?.Name</td>
            <td>@o.ConnectionType</td>
            <td>@o.Status</td>
            <td>@o.PlacedOn.ToString("dd MMM yyyy")</td>
        </tr>
    }}
    </tbody>
</table>
<h4>Connections</h4>
<table class="table table-striped table-sm">
    <thead><tr><th>Account ID</th><th>Customer</th><th>Status</th><th>Activated</th></tr></thead>
    <tbody>
    @if (connections != null) { foreach (var c in connections) {
        <tr>
            <td><a asp-controller="Connections" asp-action="Details" asp-route-id="@c.Id">@c.AccountId</a></td>
            <td>@c.Customer?.Name</td>
            <td>@c.Status</td>
            <td>@c.ActivatedOn.ToString("dd MMM yyyy")</td>
        </tr>
    }}
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">Back</a>
