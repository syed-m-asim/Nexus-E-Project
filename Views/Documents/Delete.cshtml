@* Delete confirmation page for a customer document. The record is deleted only after the user confirms (POST + anti-forgery token). *@
@model NexusCommunication.Models.CustomerDocument
@{ ViewData["Title"] = "Delete Document"; }
<h2>Delete document @Model.OriginalFileName?</h2>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" />
<button type="submit" class="btn btn-danger">Delete</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
