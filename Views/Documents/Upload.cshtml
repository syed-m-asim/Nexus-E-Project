@* Upload form for customer documents. File size / type and year are limited here and checked again in DocumentsController.Upload. *@
@{ ViewData["Title"] = "File Document"; }
<h2>File Customer Document</h2>
<p class="text-muted">Address proofs, application forms and receipts are filed by year and area (city).</p>
<form asp-action="Upload" method="post" enctype="multipart/form-data">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-2"><label>Customer</label><select name="customerId" class="form-select" asp-items="ViewBag.CustomerId" required><option value="">-- Select customer --</option></select></div>
<div class="mb-2"><label>Document Type</label><select name="documentType" class="form-select" asp-items="Html.GetEnumSelectList<NexusCommunication.Models.DocumentType>()"></select></div>
<div class="mb-2"><label>Filed Year</label><input name="filedYear" type="number" class="form-control" value="@DateTime.Now.Year" min="2000" max="@(DateTime.Now.Year + 1)" required /></div>
<div class="mb-2"><label>City / Area</label><select name="cityId" class="form-select" asp-items="ViewBag.CityId"><option value="">--</option></select></div>
<div class="mb-2"><label>File</label><input name="file" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required /></div>
<button type="submit" class="btn btn-primary">Upload & File</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
