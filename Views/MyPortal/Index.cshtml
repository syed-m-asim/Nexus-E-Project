@* Customer dashboard (counts of own orders, connections and bills). *@
@{
    ViewData["Title"] = "My Portal";
    var customer = ViewBag.Customer as NexusCommunication.Models.Customer;
}
<h2>Welcome@(customer != null ? ", " + customer.Name : "")</h2>
@if (customer == null)
{
    <div class="alert alert-warning">No customer profile linked to your email. Contact retail outlet to register your customer record with the same email used for login.</div>
}
else
{
<div class="row g-3">
    <div class="col-12 col-sm-4"><div class="card text-center"><div class="card-body"><h3>@ViewBag.OrderCount</h3><p>Orders</p><a asp-action="Orders" class="btn btn-sm btn-primary">View</a></div></div></div>
    <div class="col-12 col-sm-4"><div class="card text-center"><div class="card-body"><h3>@ViewBag.ConnectionCount</h3><p>Connections</p><a asp-action="Connections" class="btn btn-sm btn-primary">View</a></div></div></div>
    <div class="col-12 col-sm-4"><div class="card text-center"><div class="card-body"><h3>@ViewBag.BillCount</h3><p>Bills</p><a asp-action="Bills" class="btn btn-sm btn-primary">View</a></div></div></div>
</div>
<p class="mt-3">
<a asp-action="PlaceOrder" class="btn btn-success">Place New Order</a>
<a asp-controller="Feedbacks" asp-action="Create" class="btn btn-outline-success">Give Feedback</a>
<a asp-controller="Search" asp-action="Index" class="btn btn-outline-secondary">Search Status</a>
</p>
}
