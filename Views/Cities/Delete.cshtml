@* Delete confirmation page for a city. The record is deleted only after the user confirms (POST + anti-forgery token). *@
@model NexusCommunication.Models.City
@{ ViewData["Title"] = "Delete City"; }
<h2>Delete @Model.Name (@Model.Code)?</h2>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" />
<button type="submit" class="btn btn-danger">Delete</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
