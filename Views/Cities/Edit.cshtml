@* Edit-city form. Same validation as Create. *@
@model NexusCommunication.Models.City
@{ ViewData["Title"] = "Edit City"; }
<h2>Edit City</h2>
<form asp-action="Edit" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Karachi" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Code"></label><input asp-for="Code" class="form-control" maxlength="3" required /><span asp-validation-for="Code" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
