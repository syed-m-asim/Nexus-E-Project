@* Add-city form. Code must be exactly 3 digits and unique (CitiesController). *@
@model NexusCommunication.Models.City
@{ ViewData["Title"] = "Add City"; }
<h2>Add City</h2>
<form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Karachi" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Code"></label><input asp-for="Code" class="form-control" placeholder="001" maxlength="3" inputmode="numeric" required /><span asp-validation-for="Code" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
