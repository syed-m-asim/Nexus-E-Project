@* List of orders. Also used by Orders/Pending (orders waiting for technical work). *@
@model IEnumerable<NexusCommunication.Models.Order>
@{ ViewData["Title"] = "Orders"; }
<h2>Orders
@if (User.IsInRole("RetailEmployee") || User.IsInRole("Admin")) {
    <a class="btn btn-sm btn-success" asp-action="Create">Place Order</a>
}
</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<table class="table table-striped table-sm">
<thead><tr><th>Order ID</th><th>Customer</th><th>Type</th><th>Plan</th><th>Status</th><th>Date</th><th class="th-actions">Actions</th></tr></thead>
<tbody>
@foreach (var o in Model) {
<tr>
<td>@o.OrderNumber</td>
<td>@o.Customer?.Name</td>
<td>@o.ConnectionType</td>
<td>@o.Plan?.Name</td>
<td><span class="badge bg-secondary">@o.Status</span></td>
<td>@o.PlacedOn.ToString("dd MMM yyyy")</td>
<td><a asp-action="Details" asp-route-id="@o.Id">Details</a></td>
</tr>
}
</tbody>
</table>
