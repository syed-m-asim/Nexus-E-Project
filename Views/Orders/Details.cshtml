@* Order details with feasibility results. Technical staff / Admin also get the feasibility link, the Create Connection link and the manual status update form. *@
@model NexusCommunication.Models.Order
@{ ViewData["Title"] = "Order Details"; }
<h2>Order @Model.OrderNumber</h2>
<dl class="row">
<dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.Name (@Model.Customer?.Phone)</dd>
<dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@Model.Plan?.Name</dd>
@if (Model.LandlinePlan != null) { <dt class="col-sm-3">Landline Plan</dt><dd class="col-sm-9">@Model.LandlinePlan.Name</dd> }
<dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.ConnectionType</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge bg-info">@Model.Status</span></dd>
<dt class="col-sm-3">City / Store</dt><dd class="col-sm-9">@Model.City?.Name / @Model.RetailStore?.Name</dd>
<dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.InstallationAddress</dd>
<dt class="col-sm-3">Connections</dt><dd class="col-sm-9">@Model.NumberOfConnections (discount @Model.BulkDiscountPercent%)</dd>
<dt class="col-sm-3">Equipment</dt><dd class="col-sm-9">@Model.EquipmentProduct?.Name</dd>
<dt class="col-sm-3">Placed</dt><dd class="col-sm-9">@Model.PlacedOn</dd>
</dl>
@if (Model.FeasibilityChecks?.Any() == true)
{
    <h5>Feasibility Checks</h5>
    <ul>@foreach (var c in Model.FeasibilityChecks) { <li>@c.CheckType — @(c.IsFeasible?"OK":"Fail") — @c.DistanceKm km — @c.Remarks</li> }</ul>
}
@if (User.IsInRole("Technical") || User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a class="btn btn-warning" asp-action="Feasibility" asp-route-id="@Model.Id">Record Feasibility</a>
        @if (Model.Status == NexusCommunication.Models.OrderStatus.Feasible || Model.Status == NexusCommunication.Models.OrderStatus.PartiallyProvided)
        {
            <a class="btn btn-success" asp-controller="Connections" asp-action="CreateFromOrder" asp-route-orderId="@Model.Id">Create Connection</a>
        }
    </div>
    <form asp-action="UpdateStatus" method="post" class="row g-2 mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="col-auto"><select name="status" class="form-select" asp-items="Html.GetEnumSelectList<NexusCommunication.Models.OrderStatus>()"></select></div>
        <div class="col"><input name="notes" class="form-control" placeholder="Notes (optional)" maxlength="500" /></div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Update Status</button></div>
    </form>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
