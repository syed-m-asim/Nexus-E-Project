@* Add-product form (Admin). Stock, reorder level and charges must not be negative. *@
@model NexusCommunication.Models.Product
@{ ViewData["Title"] = "Add Product"; }
<h2>Add Product</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. TP-Link Wireless Router" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Category"></label><select asp-for="Category" class="form-select" required asp-items="Html.GetEnumSelectList<NexusCommunication.Models.ProductCategory>()"><option value="">-- Select category --</option></select><span asp-validation-for="Category" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="Description"></label><textarea asp-for="Description" placeholder="Short description (optional)" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="StockQty"></label><input asp-for="StockQty" placeholder="e.g. 25" class="form-control" required /><span asp-validation-for="StockQty" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="ReorderLevel"></label><input asp-for="ReorderLevel" placeholder="e.g. 5" class="form-control" required /><span asp-validation-for="ReorderLevel" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="MonthlyRental"></label><input asp-for="MonthlyRental" placeholder="e.g. 10.00" class="form-control" required /><span asp-validation-for="MonthlyRental" class="text-danger"></span></div>
<div class="mb-2"><label asp-for="ReplacementCharge"></label><input asp-for="ReplacementCharge" placeholder="e.g. 45.00" class="form-control" required /><span asp-validation-for="ReplacementCharge" class="text-danger"></span></div>
<div class="mb-2"><label>Vendor</label><select asp-for="VendorId" class="form-select" required asp-items="ViewBag.VendorId"><option value="">-- Select vendor --</option></select><span asp-validation-for="VendorId" class="text-danger"></span></div>
<div class="mb-2"><label for="imageFile">Product Image</label><input type="file" id="imageFile" name="imageFile" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" /><div class="form-text">JPG, PNG, GIF or WEBP, up to 2 MB (optional).</div>@Html.ValidationMessage("imageFile", new { @class = "text-danger" })<img id="imagePreview" class="product-preview mt-2" style="display:none" alt="Preview" /></div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" />
<script>
document.getElementById('imageFile').addEventListener('change', function () {
  var f = this.files && this.files[0], img = document.getElementById('imagePreview');
  if (f && f.type.indexOf('image/') === 0) { img.src = URL.createObjectURL(f); img.style.display = 'block'; } else { img.style.display = 'none'; }
});
</script> }
