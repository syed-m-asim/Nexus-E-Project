@* Connection details with the action forms: change status, change plan and equipment replacement charge. *@
@model NexusCommunication.Models.Connection
@{
    ViewData["Title"] = "Connection Details";
    var planChanges = ViewBag.PlanChanges as IEnumerable<NexusCommunication.Models.ConnectionPlanChange>;
    var replacements = ViewBag.Replacements as IEnumerable<NexusCommunication.Models.ReplacementCharge>;
    var statusHistory = ViewBag.StatusHistory as IEnumerable<NexusCommunication.Models.ConnectionStatusHistory>;
    var empNames = ViewBag.EmployeeNames as Dictionary<int, string>;
}
<h2>Account @Model.AccountId</h2>
<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.Customer?.Name</dd>
    <dt class="col-sm-3">Plan</dt>
    <dd class="col-sm-9">@Model.Plan?.Name</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Activated</dt>
    <dd class="col-sm-9">@Model.ActivatedOn</dd>
    <dt class="col-sm-3">Deposit</dt>
    <dd class="col-sm-9">@Model.SecurityDepositAmount.ToString("C") (charged: @Model.SecurityDepositCharged.ToString("C"))</dd>
</dl>
@if (User.IsInRole("Technical") || User.IsInRole("Admin"))
{
    <form asp-action="ChangeStatus" method="post" class="mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <select name="status" class="form-select d-inline-block w-auto" asp-items="Html.GetEnumSelectList<NexusCommunication.Models.ConnectionStatus>()"></select>
        <input name="reason" class="form-control d-inline-block w-auto" placeholder="Reason (optional)" maxlength="300" />
        <button type="submit" class="btn btn-warning">Change Status</button>
    </form>
}
@if (Model.RefundAmount != null)
{
    <div class="alert alert-info">Security deposit refunded: @Model.RefundAmount.Value.ToString("C") on @Model.RefundedOn</div>
}
@if ((User.IsInRole("Accounts") || User.IsInRole("Admin")) && Model.Status == NexusCommunication.Models.ConnectionStatus.PermanentlyInactive && Model.SecurityDepositBilled && Model.RefundAmount == null)
{
    <form asp-action="Refund" method="post" class="mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-success">Refund Security Deposit (@Model.SecurityDepositCharged.ToString("C"))</button>
    </form>
}
@if (User.IsInRole("Technical") || User.IsInRole("Admin") || User.IsInRole("RetailEmployee"))
{
    <div class="card mb-3">
        <div class="card-header">Change Plan</div><div class="card-body">
        <form asp-action="ChangePlan" method="post" class="row g-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-12 col-sm-6 col-md-4"><select name="newPlanId" class="form-select" asp-items="ViewBag.Plans"></select></div>
            <div class="col-12 col-sm-6 col-md-4"><input name="reason" class="form-control" placeholder="Reason" maxlength="300" /></div>
            <div class="col-12 col-sm-6 col-md-2"><button type="submit" class="btn btn-primary">Change Plan</button></div>
        </form>
    </div>
</div>
}
@if (User.IsInRole("Technical") || User.IsInRole("Admin"))
{
    <div class="card mb-3">
        <div class="card-header">Equipment Replacement Charge</div><div class="card-body">
        <form asp-action="AddReplacement" method="post" class="row g-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-12 col-sm-6 col-md-3"><select name="productId" class="form-select" asp-items="ViewBag.Products"><option value="">-- Select product --</option></select></div>
            <div class="col-12 col-sm-6 col-md-2"><input name="quantity" type="number" value="1" min="1" max="100" step="1" class="form-control" required /></div>
            <div class="col-12 col-sm-6 col-md-4"><input name="reason" class="form-control" placeholder="Reason (spoiled equipment)" maxlength="300" /></div>
            <div class="col-12 col-sm-6 col-md-2"><button type="submit" class="btn btn-danger">Add Charge</button></div>
        </form>
    </div>
</div>
}
@if (statusHistory?.Any() == true)
{
    <h5>Status History</h5>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Old Status</th><th>New Status</th><th>Reason</th><th>Changed By</th></tr></thead>
        <tbody>
            @foreach (var h in statusHistory)
            {
                <tr>
                    <td>@h.ChangedOn.ToLocalTime().ToString("g")</td>
                    <td>@h.OldStatus</td>
                    <td>@h.NewStatus</td>
                    <td>@h.Reason</td>
                    <td>@(h.ChangedByEmployeeId != null && empNames != null && empNames.ContainsKey(h.ChangedByEmployeeId.Value) ? empNames[h.ChangedByEmployeeId.Value] : "System / Automatic")</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (planChanges?.Any() == true)
{
    <h5>Plan Change History</h5>
    <ul>@foreach (var p in planChanges) {
        <li>@p.ChangedOn.ToString("g"): Plan @p.OldPlanId → @p.NewPlanId (@p.Reason)</li>
    }
</ul>
}
@if (replacements?.Any() == true)
{
    <h5>Replacement Charges</h5>
    <table class="table table-sm">
        <thead><tr><th>Product</th><th>Qty</th><th>Amount</th><th>Billed?</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var r in replacements)
            {
                <tr><td>@r.Product?.Name</td><td>@r.Quantity</td><td>@r.Amount.ToString("C")</td><td>@(r.BillId.HasValue ? "Yes" : "Pending")</td><td>@r.CreatedOn.ToString("g")</td></tr>
            }
        </tbody>
    </table>
}



<div class="card mt-3 p-3">
    <h5>Record Hourly Usage</h5>
    <form asp-action="RecordUsage" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row g-2">
            <div class="col-12 col-sm-6 col-md-3"><label class="form-label">Hours used</label><input name="hoursUsed" type="number" step="0.01" class="form-control" required /></div>
            <div class="col-12 col-sm-6 col-md-3"><label class="form-label">Period start</label><input name="periodStart" type="date" class="form-control" /></div>
            <div class="col-12 col-sm-6 col-md-3"><label class="form-label">Period end</label><input name="periodEnd" type="date" class="form-control" /></div>
            <div class="col-12 col-sm-6 col-md-3"><label class="form-label">Notes</label><input name="notes" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-sm btn-primary mt-2">Save Usage</button>
    </form>
</div>
<br />

<a asp-action="Index" class="btn btn-secondary">Back</a>