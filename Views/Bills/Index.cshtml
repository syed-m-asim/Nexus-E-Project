@* List page: all bills in a table with action links. *@
@model IEnumerable<NexusCommunication.Models.Bill>
@{ ViewData["Title"] = "Bills"; }
<h2>Bills
@if (User.IsInRole("Accounts") || User.IsInRole("Admin")) {
<a class="btn btn-sm btn-success" asp-action="Generate">Generate Bill</a>
}
</h2>
<table class="table table-striped table-sm">
<thead><tr><th>Bill #</th><th>Account</th><th>Customer</th><th>Total</th><th>Due</th><th>Status</th><th>Date</th><th class="th-actions">Actions</th></tr></thead>
<tbody>
@foreach (var b in Model) {
<tr>
<td>@b.BillNumber</td>
<td>@b.Connection?.AccountId</td>
<td>@b.Connection?.Customer?.Name</td>
<td>@b.TotalAmount.ToString("C")</td>
<td>@b.BalanceDue.ToString("C")</td>
<td>@b.Status</td>
<td>@b.BillDate.ToString("dd MMM yyyy")</td>
<td><a asp-action="Details" asp-route-id="@b.Id">Details</a></td>
</tr>
}
</tbody>
</table>
