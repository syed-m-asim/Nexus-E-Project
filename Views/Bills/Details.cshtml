@* One bill with all line items, tax and payments received. *@
@model NexusCommunication.Models.Bill
@{ ViewData["Title"] = "Bill Details"; }
<h2>Bill @Model.BillNumber</h2>
<dl class="row">
<dt class="col-sm-3">Account</dt><dd class="col-sm-9">@Model.Connection?.AccountId</dd>
<dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Connection?.Customer?.Name</dd>
<dt class="col-sm-3">Period</dt><dd class="col-sm-9">@Model.PeriodStart.ToString("dd MMM") - @Model.PeriodEnd.ToString("dd MMM yyyy")</dd>
<dt class="col-sm-3">Subtotal</dt><dd class="col-sm-9">@Model.Subtotal.ToString("C")</dd>
<dt class="col-sm-3">Discount</dt><dd class="col-sm-9">@Model.DiscountAmount.ToString("C")</dd>
<dt class="col-sm-3">Tax (@((Model.TaxRate*100).ToString("0.##"))%)</dt><dd class="col-sm-9">@Model.TaxAmount.ToString("C")</dd>
<dt class="col-sm-3">Total</dt><dd class="col-sm-9"><strong>@Model.TotalAmount.ToString("C")</strong></dd>
<dt class="col-sm-3">Paid / Due</dt><dd class="col-sm-9">@Model.AmountPaid.ToString("C") / @Model.BalanceDue.ToString("C")</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>
@if (Model.LineItems?.Any() == true) {
<table class="table table-sm"><thead><tr><th>Description</th><th>Amount</th></tr></thead>
<tbody>@foreach (var li in Model.LineItems) { <tr><td>@li.Description</td><td>@li.Amount.ToString("C")</td></tr> }</tbody></table>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
